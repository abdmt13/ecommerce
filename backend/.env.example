APP_NAME=Ecommerce API
DEBUG=false
# PostgreSQL: crear la base y configurar credenciales locales antes de usar persistencia.
DATABASE_URL=postgresql+asyncpg://ecommerce:local_password@localhost:5432/ecommerce
# MySQL: uv sync --extra mysql, y usar mysql+asyncmy://usuario:clave@localhost:3306/ecommerce
CORS_ORIGINS=["http://localhost:3000"]
